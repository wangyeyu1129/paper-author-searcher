# Copy to deploy/.env (git-ignored) and fill in. Secrets live only here or in your secret store.

# Data sources (see README: OpenAlex has a free daily quota with a key).
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=
CROSSREF_MAILTO=
CORE_API_KEY=
OPENREVIEW_TOKEN=

# API keys accepted by the service, as id:name:sha256 (paper-search-api create-key prints this line), comma
# separated. Alternatively create keys into the data volume: docker compose run --rm api create-key --name agent
PAPER_SEARCH__SERVICE__API_KEY_HASHES=

# Spend cap per search, in USD.
PAPER_SEARCH__SERVICE__MAXIMUM_COST_USD=0.5

# Object storage for PDFs (default: the data volume). For S3 or MinIO (compose profile "s3"):
# PAPER_SEARCH__SERVICE__FILE_STORE=s3
# PAPER_SEARCH__SERVICE__S3_ENDPOINT=http://minio:9000
# PAPER_SEARCH__SERVICE__S3_PUBLIC_ENDPOINT=http://localhost:9000
# PAPER_SEARCH__SERVICE__S3_BUCKET=paper-search
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MinIO's own root user (profile "s3" only); use the same pair as above.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# Readiness also requires the DBLP index and catalog store once the indexer has built them.
PAPER_SEARCH__SERVICE__REQUIRE_INDEXES=false
